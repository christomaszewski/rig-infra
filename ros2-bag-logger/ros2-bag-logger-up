#!/usr/bin/env bash
# Launcher for the vehicle's shared ROS 2 bag logger (infra). rig brings it up just AFTER the zenoh router
# (order ~1) so it records the graph from the start, exporting ROS_DOMAIN_ID / RMW_IMPLEMENTATION /
# RIG_DATA_DIR. It records the telemetry graph to ${RIG_DATA_DIR}/current/bags/<name> (run-aware; flat without a registry); image topics are excluded
# by default (camera-service records compressed video at the source). SELECTS + PARAMETERIZES `ros2 bag
# record` — it does not generate compose.
set -euo pipefail
REPO="$(cd "$(dirname "$0")" && pwd)"
PYTHON="${BAG_LOGGER_PYTHON:-python3}"

CONFIG="${1:?usage: ros2-bag-logger-up <config.yaml> [up [-d]|down|status|logs|config|export|...]}"; shift || true
[ -f "$CONFIG" ] || { echo "ros2-bag-logger-up: config not found: $CONFIG" >&2; exit 1; }
CONFIG_ABS="$(cd "$(dirname "$CONFIG")" && pwd)/$(basename "$CONFIG")"
INSPECT=()
case "${1:-}" in
  runtime-images|images) INSPECT=(--inspect) ;;
  down|status|logs|ps|stop|rm) INSPECT=(--legacy-control) ;;
esac

# `export` (v1.14.0, rig ≥ v0.2.54 `rig run export`): re-write THIS instance's sessions of a sealed
# run smaller — `ros2 bag convert` per session (recompress at the profile's preset, drop topics,
# cut a window) in the logger's own image, into the export dir rig names. bag_export.py renders
# one spec per session + a convert script under $RIG_EXPORT_DEST/.rig/export/<name>/ and prints
# "<script>\t<count>\t<name>"; both dirs are mounted at their HOST paths (the script and specs name
# host paths; the source read-only). A one-off `compose run` beside whatever is recording now —
# never the recorder's container. Nothing to convert exits 0 without docker.
if [ "${1:-}" = "export" ]; then
  # bash 3.2 (macOS dev boxes) chokes on quotes inside ${:?} words — keep these messages plain
  : "${RIG_EXPORT_SOURCE:?ros2-bag-logger-up export: RIG_EXPORT_SOURCE, the run dir, is unset - rig run export sets it; this verb is not for standalone use}"
  : "${RIG_EXPORT_DEST:?ros2-bag-logger-up export: RIG_EXPORT_DEST, the export dir, is unset}"
  PLAN="$("$PYTHON" "$REPO/tools/bag_export.py" "$CONFIG_ABS" "$REPO")"   # "<script>\t<count>\t<name>"
  REST="$PLAN"
  SCRIPT="${REST%%$'\t'*}"; REST="${REST#*$'\t'}"
  COUNT="${REST%%$'\t'*}"; NAME="${REST#*$'\t'}"
  if [ "$COUNT" = "0" ]; then
    echo "ros2-bag-logger-up: export: nothing to convert" >&2
    exit 0
  fi
  export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-ros2-bag-logger_${NAME}}"
  export BAG_RECORD_SCRIPT="$SCRIPT"   # satisfies the compose's required mount (unused by the run)
  echo "ros2-bag-logger-up: export: project=${COMPOSE_PROJECT_NAME} sessions=${COUNT} script=$SCRIPT" >&2
  # In place (v1.15.0, rig run export --in-place): the run is source AND destination — ONE
  # writable mount; the script verifies every converted session before it replaces the original.
  if [ "${RIG_EXPORT_INPLACE:-}" = "1" ]; then
    exec docker compose -f "$REPO/docker/compose.deploy.yaml" run --rm --no-deps -T \
      -v "$RIG_EXPORT_SOURCE:$RIG_EXPORT_SOURCE" \
      bag-logger /bin/bash "$SCRIPT"
  fi
  exec docker compose -f "$REPO/docker/compose.deploy.yaml" run --rm --no-deps -T \
    -v "$RIG_EXPORT_SOURCE:$RIG_EXPORT_SOURCE:ro" -v "$RIG_EXPORT_DEST:$RIG_EXPORT_DEST" \
    bag-logger /bin/bash "$SCRIPT"
fi

# Legacy graph/system capture remains in this project for the compatibility release.
# Config parsing warns about migration; diagnostics are never implicitly enabled.
NAME_AND_SCRIPT="$("$PYTHON" "$REPO/tools/bag_cmd.py" "$CONFIG_ABS" "$REPO" ${INSPECT[@]+"${INSPECT[@]}"})"
REST="$NAME_AND_SCRIPT"
NAME="${REST%%$'\t'*}"; REST="${REST#*$'\t'}"
SCRIPT="${REST%%$'\t'*}"; REST="${REST#*$'\t'}"
SHM_FLAG="${REST%%$'\t'*}"; REST="${REST#*$'\t'}"
GRAPH_ENABLED="${REST%%$'\t'*}"; REST="${REST#*$'\t'}"
GRAPH_INTERVAL="${REST%%$'\t'*}"; REST="${REST#*$'\t'}"
GRAPH_SETTLE="${REST%%$'\t'*}"; REST="${REST#*$'\t'}"
SYSTEM_ENABLED="${REST%%$'\t'*}"; REST="${REST#*$'\t'}"
SYSTEM_INTERVAL="${REST%%$'\t'*}"; REST="${REST#*$'\t'}"
SYSTEM_SETTINGS_INTERVAL="${REST%%$'\t'*}"
GRAPH_ENDPOINTS="${REST#*$'\t'}"
export BAG_LOGGER_NAME="$NAME"
export BAG_RECORD_SCRIPT="$SCRIPT"
export GRAPH_SNAPSHOT_NAME="$NAME" GRAPH_SNAPSHOT_ENABLED="$GRAPH_ENABLED"
# An omitted/null timing used the caller's environment (or Compose's default) in v1.20.1.
[ -z "$GRAPH_INTERVAL" ] || export GRAPH_SNAPSHOT_INTERVAL_S="$GRAPH_INTERVAL"
[ -z "$GRAPH_SETTLE" ] || export GRAPH_SNAPSHOT_SETTLE_S="$GRAPH_SETTLE"
export GRAPH_SNAPSHOT_ENDPOINTS_ENABLED="$GRAPH_ENDPOINTS"
export SYSTEM_SNAPSHOT_NAME="$NAME" SYSTEM_SNAPSHOT_ENABLED="$SYSTEM_ENABLED"
export SYSTEM_SNAPSHOT_INTERVAL_S="$SYSTEM_INTERVAL"
export SYSTEM_SNAPSHOT_SETTINGS_INTERVAL_S="$SYSTEM_SETTINGS_INTERVAL"
export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-ros2-bag-logger_${NAME}}"
FILES=(-f "$REPO/docker/compose.deploy.yaml")
[ "$SHM_FLAG" = "shm" ] && FILES+=(-f "$REPO/docker/compose.shm.yaml")
ARGS=("$@"); [ ${#ARGS[@]} -eq 0 ] && ARGS=(up)
[ "${ARGS[0]}" = "status" ] && ARGS=(ps "${ARGS[@]:1}")
LEGACY_ACTIVE=false
if [ "$GRAPH_ENABLED" = true ] || [ "$SYSTEM_ENABLED" = true ]; then LEGACY_ACTIVE=true; fi
case "${ARGS[0]}" in
  up|config|images|runtime-images)
    if [ "$LEGACY_ACTIVE" = true ]; then
      FILES+=(-f "$REPO/docker/compose.legacy-observer.yaml" --profile legacy-observer)
      [ "$SYSTEM_ENABLED" = true ] && FILES+=(-f "$REPO/docker/compose.legacy-system.yaml")
    fi ;;
  down|ps|logs|stop|rm)
    # Always address old sidecars, including after their config blocks were removed.
    FILES+=(-f "$REPO/docker/compose.legacy-observer.yaml" --profile legacy-observer) ;;
  *)
    # As in the released base model, Compose activates this profiled service when
    # a passthrough command explicitly targets it (e.g. restart graph-snapshotter).
    FILES+=(-f "$REPO/docker/compose.legacy-observer.yaml")
    [ "$SYSTEM_ENABLED" != true ] || FILES+=(-f "$REPO/docker/compose.legacy-system.yaml") ;;
esac
case "${ARGS[0]}" in
  runtime-images|images)
    exec "$PYTHON" "$REPO/tools/runtime_images.py" "${ARGS[0]}" "${FILES[@]}" ;;
  up)
    if [ "$LEGACY_ACTIVE" != true ]; then
      # A migrated config removes only this project's former sidecar. Keep run files,
      # volumes, the recorder, and any independently configured observer project.
      docker compose "${FILES[@]}" -f "$REPO/docker/compose.legacy-observer.yaml" \
        --profile legacy-observer rm --stop --force graph-snapshotter
    fi
    if [ "$SYSTEM_ENABLED" = true ]; then
      "$PYTHON" "$REPO/tools/observer/host_probe.py" --data-root "${RIG_DATA_DIR:-/data}" --name "$NAME" || \
        echo "ros2-bag-logger: native host probe failed; continuing legacy system capture" >&2
    fi
    if [ "${RIG_RUNTIME_IMAGE_PINS+x}" ]; then
      exec "$PYTHON" "$REPO/tools/runtime_images.py" pinned-up "${FILES[@]}" -- "${ARGS[@]:1}"
    fi ;;
esac
echo "ros2-bag-logger-up: project=${COMPOSE_PROJECT_NAME} domain=${ROS_DOMAIN_ID:-0} rmw=${RMW_IMPLEMENTATION:-?} script=$SCRIPT${SHM_FLAG:+ shm=on}" >&2
exec docker compose "${FILES[@]}" "${ARGS[@]}"
